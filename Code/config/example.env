# Example local configuration. Copy to Code/.env and replace the placeholders.
# Placeholders only: never put real credentials in this file.
# Settings are described in Code/docs/configuration.md.

FFD_ENV=local
LOG_LEVEL=INFO

# secret
DATABASE_URL=postgresql+psycopg://ffd:change-me@localhost:5432/ffd

AWS_REGION=ap-south-1
AWS_PROFILE=ffd-dev
S3_BUCKET=ffd-poc-artifacts-example
S3_TEXTRACT_PREFIX=textract-input/
TEXTRACT_FEATURES=TABLES,FORMS
BEDROCK_MODEL_ID=example.text-model-id
BEDROCK_EMBEDDING_MODEL_ID=example.embedding-model-id

NSE_BASE_URL=https://www.nseindia.com
BSE_BASE_URL=https://www.bseindia.com
NEWS_SOURCES_FILE=config/news-sources.yaml
HTTP_USER_AGENT=ffd-poc/0.1 (contact@example.com)
HTTP_REQUEST_DELAY_SECONDS=2

APP_USERNAME=analyst
# secret
APP_PASSWORD_HASH=replace-with-password-hash
